{
  "name": "portuguese-learning",
  "version": "1.0.0",
  "description": "Portuguese Learning Website with Express.js and Material-UI",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "webpack --mode production",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json src/server.ts",
    "dev:client": "webpack serve --mode development",
    "start": "node dist/server.js",
    "test": "./run-tests.sh",
    "test:server": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json src/server.ts",
    "test:headed": "./run-tests.sh --headed",
    "test:ui": "./run-tests.sh --ui",
    "test:report": "playwright show-report",
    "test:smoke": "./run-tests.sh --grep @smoke",
    "test:ci": "CI=true npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "mongoose": "^9.6.2",
    "react-i18next": "^17.0.8",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "concurrently": "^10.0.0",
    "css-loader": "^7.1.4",
    "html-webpack-plugin": "^5.6.7",
    "mongodb-memory-server": "^11.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  }
}
