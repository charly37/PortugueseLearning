{
  "name": "portuguese-learning",
  "version": "1.0.0",
  "description": "Portuguese Learning Website with Express.js and Material-UI",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "webpack --mode production",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json src/server.ts",
    "dev:client": "webpack serve --mode development",
    "start": "node dist/server.js",
    "test": "./run-tests.sh",
    "test:server": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json src/server.ts",
    "test:headed": "./run-tests.sh --headed",
    "test:ui": "./run-tests.sh --ui",
    "test:report": "playwright show-report",
    "test:smoke": "./run-tests.sh --grep @smoke",
    "test:ci": "CI=true npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "mongoose": "^9.6.2",
    "react-i18next": "^16.6.6",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "css-loader": "^6.11.0",
    "html-webpack-plugin": "^5.6.7",
    "mongodb-memory-server": "^10.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  }
}
