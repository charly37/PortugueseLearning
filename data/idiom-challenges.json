        "fr": {
            "translation": "rencontrer quelqu'un",
            "note": "Notez que 'rencontrer quelqu'un' est la façon standard de dire que l'on rencontre une personne. Si l'on parle de deux personnes qui se voient mutuellement, on dira plutôt 'se rencontrer'.",
            "use_exemple": "Je vais rencontrer João demain.",
            "port_exemple": "Vou encontrar-me com o João amanhã.",
            "last_update": "2026-05-09"
        },
        "en": {
            "translation": "to meet up with",
            "note": "Best translation: to meet up with (casual) or to meet with (for formal meetings). It’s used for arranging a meeting with someone.",
